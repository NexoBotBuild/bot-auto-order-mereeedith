# ===== Telegram =====
# Token dari @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID admin (boleh lebih dari satu, pisah dengan koma)
# Cek ID kamu lewat @userinfobot
ADMIN_IDS=123456789

# ===== Database (Supabase Postgres) =====
# Ambil dari Supabase: Project Settings > Database > Connection string.
# REKOMENDASI untuk bot (proses jalan terus): pakai "Session pooler" PORT 5432 —
# ini mendukung prepared-statement cache → query jauh lebih cepat/ringan.
# Contoh (port 5432, BUKAN 6543):
# postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
#
# Catatan: "Transaction pooler" (port 6543) juga jalan, tapi lebih lambat karena
# prepared-statement cache dimatikan. Bot otomatis mendeteksi port 6543.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres

# ===== Pakasir =====
# Slug project & API key dari dashboard Pakasir (Settings project)
PAKASIR_PROJECT=namaprojectmu
PAKASIR_API_KEY=apikeymu
PAKASIR_BASE_URL=https://app.pakasir.com

# ===== Web server (webhook Pakasir + health check) =====
# Railway otomatis mengisi PORT. Untuk lokal default 8080.
PORT=8080
# Domain publik (Railway) untuk dipasang sebagai webhook URL di dashboard Pakasir.
# Contoh: https://botmu.up.railway.app  (tanpa trailing slash)
PUBLIC_BASE_URL=

# Nama bot/toko (tampil di pesan ke pengguna)
STORE_NAME=Auto Order Bot

# Berapa detik QRIS berlaku kalau Pakasir tidak mengembalikan expired_at (default 1800 = 30 menit)
ORDER_EXPIRE_SECONDS=1800
